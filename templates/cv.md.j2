<#
  Website CV page -> out/cv.md (channel "web", default language; `build.py md --lang fi` for another).
  A generic starting point: adapt it to your site, or add more templates/*.md.j2 files
  (each one renders to out/<name>.md).

  Jinja delimiters are changed so that Jekyll/Liquid {{ }} and {% %} pass through as-is:
  variables use double angle brackets, blocks angle bracket + percent, comments
  angle bracket + hash (see AGENTS.md).
  `labels` = UI strings of the language (templates/labels.yml), `lang` = language code.
  Undefined variables are an error, so guard optional fields with `is defined`.
#>
<% set br = "  " %><# markdown hard line break (editors strip trailing spaces) #>
---
title: << basics.name >>
---
<!-- Generated by build.py md — edit data/cv.yml instead of this file -->

# << basics.name >>

**<< basics.headline >>**

<< summary >>

📧 [<< basics.email >>](mailto:<< basics.email >>)<% for l in basics.links %> · [<< l.label >>](<< l.url >>)<% endfor %>


## << labels.skills >>

<% if skills.chart is defined %>
<div style="max-width:620px; margin:0 auto;">
  <canvas id="skills-chart" height="380"></canvas>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
<script>
(function () {
  // Generated from skills.chart in data/cv.yml (x,y 0-100, r px)
  var SKILLS = [
<% for s in skills.chart['items'] %>
    { label: << s.label | tojson >>, x: << s.x >>, y: << s.y >>, r: << s.r >>, cat: << s.cat >> },
<% endfor %>
  ];
  var CATS = [
<% for c in skills.chart.categories %>
    { label: << c.label | tojson >>, bg: '<< c.bg >>', border: '<< c.border >>' },
<% endfor %>
  ];
  Chart.register(ChartDataLabels);
  new Chart(document.getElementById('skills-chart'), {
    type: 'bubble',
    data: {
      datasets: CATS.map(function (cat, i) {
        return {
          label: cat.label, backgroundColor: cat.bg, borderColor: cat.border, borderWidth: 2,
          data: SKILLS.filter(function (s) { return s.cat === i; }),
        };
      }),
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom' },
        tooltip: { callbacks: { label: function (ctx) { return ctx.raw.label.replace('\n', ' '); } } },
        datalabels: {
          color: '#fff', textAlign: 'center',
          font: function (ctx) { return { weight: 'bold', size: Math.max(9, Math.round(ctx.raw.r * 0.27)) }; },
          formatter: function (v) { return v.label; },
        },
      },
      scales: { x: { display: false, min: 0, max: 100 }, y: { display: false, min: 0, max: 100 } },
    },
  });
})();
</script>

<% endif %>
<% for g in skills.groups %>
- **<< g.name >>:** << g['items'] | join(", ") >>
<% endfor %>

## << labels.experience >>

<% for x in experience %>
### << x.title >>, <% if x.org_url is defined %>[<< x.org >>](<< x.org_url >>)<% else %><< x.org >><% endif %> (_<< x.period >>_)
<% if x.highlights is defined %>
<% for h in x.highlights %>
- << h >>
<% endfor %>
<% else %>
<< x.summary >>
<% endif %>

<% endfor %>
## <span id="projects"><< labels.projects >></span>

<% for p in projects %>
### << p.title >> | << p.client >>
📅 _<< p.period >>_<< br >>
**<< labels.role >>:** << p.role >><% if p.industry is defined %> · **<< labels.industry >>:** << p.industry >><% endif %>

<% for h in p.highlights %>
<% if h is mapping %>
- << h.text >>
<% for s in h.sub %>
  - << s >>
<% endfor %>
<% else %>
- << h >>
<% endif %>
<% endfor %>

**<< labels.stack >>:** << p.stack | join(", ") >>

<% endfor %>
## << labels.education >>

<% for e in education %>
- **<< e.degree >>**, << e.school >>, << e.date_fmt if e.date_fmt is defined else e.period >>
<% endfor %>

## << labels.certifications >>

<% for c in certifications %>
- *<< c.date_fmt >>* << c.name >> (<< c.issuer >><% if c.note is defined %>, << c.note >><% endif %>)
<% endfor %>

## << labels.languages >>

<% for l in languages %>
- **<< l.name >>:** << l.level >>
<% endfor %>
